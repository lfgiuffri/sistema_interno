# ============================================================================
# Sistema Interno — Backend .env.example (single-tenant)
# Copiá a `.env` y completá. Todo lo OPCIONAL degrada con gracia si se deja vacío.
#
# QUICKSTART (lo mínimo para arrancar local): JWT_SECRET + credenciales de DB.
# El resto tiene defaults sanos o se puede dejar vacío.
# ============================================================================

# ─── App ─────────────────────────────────────────────────────────────────────
PORT=3010
NODE_ENV=development
APP_NAME=Sistema Interno
TIMEZONE=America/Argentina/Buenos_Aires
PUBLIC_API_URL=http://localhost:3010/api
FRONTEND_URL=http://localhost:8100
CORS_ORIGIN=*

# ─── JWT — REQUERIDO (el server no arranca sin JWT_SECRET) ───────────────────
# Secreto largo y aleatorio (>=32 chars). Generá uno con: openssl rand -hex 32
JWT_SECRET=cambiar-por-un-secret-seguro-de-32-chars-o-mas
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# ─── Base de datos — REQUERIDO (MySQL o MariaDB) ─────────────────────────────
# DBDRIVER: mysql | mariadb  (usá 'mysql' para MySQL 8.x).
DBDRIVER=mariadb
# Base única de la aplicación.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=sistema_interno
DB_USER=root
DB_PASS=cambiar
# ─── Usuario admin inicial (sembrado por init_db) ────────────────────────────
ADMINUSER=admin
ADMINPASS=admin123

# ─── Redis — OPCIONAL (cache, rate-limit, BullMQ) ────────────────────────────
# Vacío = todo cae a fallback in-process (no hace falta Redis para dev).
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── Billing — OPCIONAL (Mercado Pago primero; Stripe también soportado) ─────
# Guía end-to-end: docs/billing-mercadopago-setup.md
BILLING_DEFAULT_PROVIDER=mercadopago     # mercadopago | stripe
BILLING_DOWNGRADE_PLAN=free              # plan al cancelar
# Mercado Pago (test): token + secret de webhook + un MP_PLAN_<PLAN> por plan pago.
# La key del plan se sanitiza: 'pro-custom' → MP_PLAN_PRO_CUSTOM.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MP_PLAN_PREMIUM=
MP_PLAN_ENTERPRISE=
# Stripe (alternativa)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PREMIUM=
STRIPE_PRICE_ENTERPRISE=

# ─── Auth avanzado — OPCIONAL ────────────────────────────────────────────────
# Auth0 (login social). Vacío = deshabilitado.
AUTH0_DOMAIN=
AUTH0_AUDIENCE=
# MFA / passwordless (OTP + magic link) / self-signup
MFA_TOKEN_TTL=10m
PASSWORDLESS_TTL_MIN=10
SIGNUP_TTL_MIN=60
# Captcha del self-signup (anti-fantasma). provider: turnstile | hcaptcha. Vacío = sin captcha (dev).
CAPTCHA_PROVIDER=
CAPTCHA_SECRET=
# Vault de secretos cifrados (AES-256-GCM). Vacío = cae a JWT_SECRET.
VAULT_KEY=

# ─── Email (mailer) — OPCIONAL ───────────────────────────────────────────────
# Sin SMTP, los emails se loguean por consola (modo dev).
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# ─── Storage — OPCIONAL ──────────────────────────────────────────────────────
STORAGE_DRIVER=local                     # local | s3
STORAGE_MAX_FILE_SIZE=52428800
# S3 / R2 / MinIO (si STORAGE_DRIVER=s3)
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=us-east-1
STORAGE_S3_ENDPOINT=
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=
STORAGE_S3_FORCE_PATH_STYLE=false
STORAGE_S3_PRESIGN_EXPIRES=900           # segundos de vigencia de las URLs presignadas

# ─── Observabilidad / error tracking — OPCIONAL (Sentry Cloud o GlitchTip self-hosted) ──
# OPT-IN: vacío = SDK no-op (no se inicializa, no sale tráfico). Con DSN = captura errores.
# Sirve para "con o sin GlitchTip" según setup. GlitchTip usa el MISMO SDK/protocolo que Sentry.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
# Tracing de performance (0 = solo errores). Ej: 0.1 para muestrear 10% de las transacciones.
SENTRY_TRACES_SAMPLE_RATE=0

# ─── IA (multi-provider: Groq → Gemini → OpenRouter) — OPCIONAL ──────────────
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# ─── Avanzado — OPCIONAL (defaults sanos) ────────────────────────────────────
WEBHOOKS_MAX_ATTEMPTS=5
FIREBASE_SERVICE_ACCOUNT_PATH=./.firebase-service-account.json
RATE_LIMIT_GLOBAL_WINDOW_MS=900000
RATE_LIMIT_GLOBAL_MAX=1000
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=10
SANDBOX_ENABLED=false
# Migraciones automáticas al boot (idempotentes). false para desactivar.
AUTO_MIGRATE=true
# Deploy desde el panel super-admin (vacío = deshabilitado).
# DEPLOY_COMMAND=
