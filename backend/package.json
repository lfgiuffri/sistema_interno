{
  "name": "sistema-interno-backend",
  "version": "2.0.0",
  "type": "module",
  "description": "Sistema Interno — backend Node/Express/Sequelize (single-tenant, base Zero 2.0).",
  "main": "index.js",
  "scripts": {
    "build": "rm -rf build && babel src --out-dir build --copy-files",
    "dev": "nodemon --watch src --ext js,mjs,cjs,json --ignore build src/index.js --exec babel-node",
    "start": "node --import ./instrument.mjs build/index.js",
    "start:sandbox-worker": "node build/exec/sandboxWorker.js",
    "dev:sandbox-worker": "babel-node src/exec/sandboxWorker.js",
    "init_db": "babel-node src/exec/initDb.js",
    "migrar_legado": "babel-node src/exec/migrarLegado.js"
  },
  "author": "Santiago Giuffrida",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1076.0",
    "@aws-sdk/s3-request-presigner": "^3.1076.0",
    "@google/generative-ai": "^0.24.1",
    "@node-rs/argon2": "^2.0.2",
    "@scalar/express-api-reference": "^0.10.7",
    "@sentry/node": "^10.63.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.79.2",
    "core-js": "^3.49.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "express-validator": "^7.3.2",
    "firebase-admin": "^14.1.0",
    "groq-sdk": "^1.3.0",
    "helmet": "^8.2.0",
    "ioredis": "^5.11.1",
    "jose": "^6.2.3",
    "jsonwebtoken": "^9.0.3",
    "mariadb": "^3.5.3",
    "mercadopago": "^3.1.0",
    "morgan": "^1.11.0",
    "multer": "^2.2.0",
    "mysql2": "^3.22.5",
    "nodemailer": "^9.0.3",
    "otplib": "^12.0.1",
    "path": "^0.12.7",
    "rate-limit-redis": "^5.0.0",
    "regenerator-runtime": "^0.14.1",
    "sanitize-html": "^2.17.6",
    "sequelize": "^6.30.0",
    "slug": "^11.0.1",
    "socket.io": "^4.8.0",
    "stripe": "^22.3.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.21.0",
    "@babel/core": "^7.21.0",
    "@babel/node": "^7.20.7",
    "@babel/preset-env": "^7.20.2",
    "nodemon": "^3.1.10"
  }
}
