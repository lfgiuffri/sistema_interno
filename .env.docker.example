# Sistema Interno — Variables de Docker Compose.
# Copiá a `.env` (en la raíz del repo) y ajustá lo que quieras. TODO tiene default sano:
# podés correr `docker compose up -d --build` sin tocar nada.
#
# ⚠️ Para producción cambiá AL MENOS: DB_PASS, JWT_SECRET y ADMINPASS.

# ── Puertos en el host ─────────────────────────────────────────────────────────
FRONTEND_PORT=8100
BACKEND_PORT=3010
DB_PORT=3306

# ── Base de datos (MariaDB en contenedor) ──────────────────────────────────────
DB_NAME=sistema_interno
DB_USER=sistema
DB_PASS=cambiar-por-una-password-segura

# ── Seguridad / admin ───────────────────────────────────────────────────────────
JWT_SECRET=cambiar-por-un-secret-seguro
ADMINUSER=admin
ADMINPASS=admin123
CORS_ORIGIN=*

# ── URLs públicas (las usa el browser; cambialas si exponés con dominio/proxy) ──
VITE_API_URL=http://localhost:3010/api
VITE_SOCKET_URL=http://localhost:3010
PUBLIC_API_URL=http://localhost:3010/api
FRONTEND_URL=http://localhost:8100

# ── Observabilidad — OPCIONAL (Sentry Cloud o GlitchTip). Vacío = no-op ─────────
# VITE_SENTRY_DSN se hornea en build del frontend; SENTRY_DSN (backend) va en backend/.env.
VITE_SENTRY_DSN=

# Las API keys de terceros (IA, Stripe, MercadoPago, S3, SMTP, Auth0…) van en
# `backend/.env` — el compose lo carga automáticamente si existe.
