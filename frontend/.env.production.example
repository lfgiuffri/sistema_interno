# Frontend del Sistema Interno - producción (APK + build prod)
#
# Vite carga .env SIEMPRE en dev. En `npm run build` (modo production)
# .env.production OVERRIDEA a .env. Ajustá estas URLs al backend de producción.

VITE_API_URL=http://localhost:3010/api
# Subdominio del portal de clientes. Si se sirve el mismo build en un host propio, ponelo acá:
# el router manda la raíz de ESE host a /portal y bloquea las rutas internas. Sin esto, el
# service worker de la PWA sirve el index.html cacheado sin pasar por nginx y su redirect
# nunca corre — el cliente termina en el login del sistema interno.
VITE_PORTAL_HOST=

VITE_SOCKET_URL=http://localhost:3010

VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_REDIRECT_URI=
