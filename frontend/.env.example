# Frontend del Sistema Interno - variables de entorno
# Copiar a `.env` y ajustar según el entorno.

VITE_API_URL=http://localhost:3010/api
VITE_SOCKET_URL=http://localhost:3010

# Auth0 (opcional). Dejar vacío para deshabilitar el login social.
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_REDIRECT_URI=

# Clave maestra para los endpoints de administración de plataforma (super_admin).
# Se envía como header `x-master-key` en las llamadas a /master/*.
VITE_MASTER_KEY=

# Cloudflare Turnstile (opcional). Si está vacío, el signup omite el captcha.
VITE_TURNSTILE_SITEKEY=

# Observabilidad / error tracking (opcional): Sentry Cloud o GlitchTip self-hosted.
# OPT-IN: vacío = no se inicializa el SDK (no-op). Se hornea en build (Vite inlinea VITE_*),
# así que cambiarla requiere rebuild del frontend.
VITE_SENTRY_DSN=
VITE_SENTRY_TRACES_SAMPLE_RATE=0
